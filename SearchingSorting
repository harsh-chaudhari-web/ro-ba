import java.util.Scanner;
import java.util.Arrays;

public class SearchingSorting {
    static int linearSearch(int[] a, int key) {
        for (int i = 0; i < a.length; i++) if (a[i] == key) return i;
        return -1;
    }

    // The array must be sorted in ascending order.
    static int binarySearch(int[] a, int key) {
        int low = 0, high = a.length - 1;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (a[mid] == key) return mid;
            if (a[mid] < key) low = mid + 1;
            else high = mid - 1;
        }
        return -1;
    }

    static void bubbleSort(int[] a) {
        for (int i = 0; i < a.length - 1; i++) {
            boolean swapped = false;
            for (int j = 0; j < a.length - 1 - i; j++) {
                if (a[j] > a[j + 1]) {
                    int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t;
                    swapped = true;
                }
            }
            if (!swapped) break;
        }
    }

    static void selectionSort(int[] a) {
        for (int i = 0; i < a.length - 1; i++) {
            int min = i;
            for (int j = i + 1; j < a.length; j++) if (a[j] < a[min]) min = j;
            int t = a[i]; a[i] = a[min]; a[min] = t;
        }
    }

    static void insertionSort(int[] a) {
        for (int i = 1; i < a.length; i++) {
            int key = a[i], j = i - 1;
            while (j >= 0 && a[j] > key) { a[j + 1] = a[j]; j--; }
            a[j + 1] = key;
        }
    }

    static void shellSort(int[] a) {
        for (int gap = a.length / 2; gap > 0; gap /= 2) {
            for (int i = gap; i < a.length; i++) {
                int temp = a[i], j = i;
                while (j >= gap && a[j - gap] > temp) { a[j] = a[j - gap]; j -= gap; }
                a[j] = temp;
            }
        }
    }

    static void quickSort(int[] a, int low, int high) {
        if (low < high) {
            int p = partition(a, low, high);
            quickSort(a, low, p - 1);
            quickSort(a, p + 1, high);
        }
    }

    static int partition(int[] a, int low, int high) {
        int pivot = a[high], i = low - 1;
        for (int j = low; j < high; j++) {
            if (a[j] <= pivot) {
                i++; int t = a[i]; a[i] = a[j]; a[j] = t;
            }
        }
        int t = a[i + 1]; a[i + 1] = a[high]; a[high] = t;
        return i + 1;
    }

    static void mergeSort(int[] a, int left, int right) {
        if (left >= right) return;
        int mid = left + (right - left) / 2;
        mergeSort(a, left, mid);
        mergeSort(a, mid + 1, right);
        merge(a, left, mid, right);
    }

    static void merge(int[] a, int left, int mid, int right) {
        int[] temp = new int[right - left + 1];
        int i = left, j = mid + 1, k = 0;
        while (i <= mid && j <= right) temp[k++] = (a[i] <= a[j]) ? a[i++] : a[j++];
        while (i <= mid) temp[k++] = a[i++];
        while (j <= right) temp[k++] = a[j++];
        for (int x = 0; x < temp.length; x++) a[left + x] = temp[x];
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("1.Linear Search  2.Binary Search  3.Bubble Sort  4.Selection Sort");
        System.out.println("5.Insertion Sort  6.Shell Sort  7.Quick Sort  8.Merge Sort");
        System.out.print("Choose option: ");
        int choice = sc.nextInt();
        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();
        if (n < 0) { System.out.println("Invalid size."); sc.close(); return; }
        int[] a = new int[n];
        System.out.println("Enter elements" + (choice == 2 ? " in ascending sorted order:" : ":"));
        for (int i = 0; i < n; i++) a[i] = sc.nextInt();

        if (choice == 1 || choice == 2) {
            System.out.print("Enter key to search: ");
            int key = sc.nextInt();
            int index = (choice == 1) ? linearSearch(a, key) : binarySearch(a, key);
            if (index == -1) System.out.println("Element not found.");
            else System.out.println("Element found at index " + index + " (position " + (index + 1) + ").");
        } else {
            switch (choice) {
                case 3: bubbleSort(a); break;
                case 4: selectionSort(a); break;
                case 5: insertionSort(a); break;
                case 6: shellSort(a); break;
                case 7: quickSort(a, 0, a.length - 1); break;
                case 8: mergeSort(a, 0, a.length - 1); break;
                default: System.out.println("Invalid option."); sc.close(); return;
            }
            System.out.println("Sorted array: " + Arrays.toString(a));
        }
        sc.close();
    }
}
